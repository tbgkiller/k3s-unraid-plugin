<?xml version="1.0"?>
<PLUGIN
  name="k3s-plugin"
  author="Dustin (TBG_Killer)"
  version="2026.03.24"
  pluginURL="https://raw.githubusercontent.com/tbgkiller/k3s-unraid-plugin/main/phase1-k3s-plugin/k3s-plugin.plg"
  support="https://forums.unraid.net/"
  min="6.12.0"
  icon="https://k3s.io/img/k3s-logo-light.svg">
  <CHANGES>
### 2026.03.24
- Initial Phase 1 scaffold for an Unraid k3s plugin.
- Installs k3s v1.35.2+k3s1.
- Adds lifecycle scripts for install, start, stop, and uninstall.
  </CHANGES>

  <FILE Name="/boot/config/plugins/k3s-plugin/install.sh" Run="/bin/bash">
    https://raw.githubusercontent.com/tbgkiller/k3s-unraid-plugin/main/phase1-k3s-plugin/install.sh
  </FILE>
  <FILE Name="/boot/config/plugins/k3s-plugin/start.sh">
    https://raw.githubusercontent.com/tbgkiller/k3s-unraid-plugin/main/phase1-k3s-plugin/start.sh
  </FILE>
  <FILE Name="/boot/config/plugins/k3s-plugin/stop.sh">
    https://raw.githubusercontent.com/tbgkiller/k3s-unraid-plugin/main/phase1-k3s-plugin/stop.sh
  </FILE>
  <FILE Name="/boot/config/plugins/k3s-plugin/uninstall.sh">
    https://raw.githubusercontent.com/tbgkiller/k3s-unraid-plugin/main/phase1-k3s-plugin/uninstall.sh
  </FILE>
  <FILE Name="/boot/config/plugins/k3s-plugin/README.md">
    https://raw.githubusercontent.com/tbgkiller/k3s-unraid-plugin/main/phase1-k3s-plugin/README.md
  </FILE>
  <FILE Name="/usr/local/emhttp/plugins/k3s-plugin/README.md">
    https://raw.githubusercontent.com/tbgkiller/k3s-unraid-plugin/main/phase1-k3s-plugin/README.md
  </FILE>
  <FILE Run="/bin/bash">
    /boot/config/plugins/k3s-plugin/install.sh
  </FILE>
</PLUGIN>

<script>
(function () {
    var statusUrl = '/plugins/k3s-plugin/k3s-status.php';
    var actionUrl = '/plugins/k3s-plugin/k3s-action.php';
    var pollIntervalMs = 5000;
    var statusBadge = document.getElementById('k3s-status-badge');
    var statusText = document.getElementById('k3s-status-text');
    var statusCopy = document.getElementById('k3s-status-copy');
    var nodeOutput = document.getElementById('k3s-node-output');
    var nodeSummary = document.getElementById('k3s-node-summary');
    var lastChecked = document.getElementById('k3s-last-checked');
    var startButton = document.getElementById('k3s-start-button');
    var stopButton = document.getElementById('k3s-stop-button');
    var actionFeedback = document.getElementById('k3s-action-feedback');
    var requestInFlight = false;
    var actionInFlight = false;

    function formatTimestamp(date) {
        return date.toLocaleTimeString([], {
            hour: 'numeric',
            minute: '2-digit',
            second: '2-digit'
        });
    }

    function setUpdating(isUpdating) {
        if (!nodeOutput) {
            return;
        }

        if (isUpdating) {
            nodeOutput.classList.add('k3s-is-updating');
        } else {
            nodeOutput.classList.remove('k3s-is-updating');
        }
    }

    function updateLastChecked(checkedAt) {
        if (checkedAt) {
            var parsed = new Date(checkedAt);
            if (!Number.isNaN(parsed.getTime())) {
                lastChecked.textContent = formatTimestamp(parsed);
                return;
            }
        }

        lastChecked.textContent = formatTimestamp(new Date());
    }

    function setActionFeedback(message, state) {
        actionFeedback.textContent = message || '';
        actionFeedback.classList.remove('is-pending', 'is-success', 'is-error');
        if (state) {
            actionFeedback.classList.add(state);
        }
    }

    function updateActionButtons(running) {
        startButton.hidden = running;
        stopButton.hidden = !running;
    }

    function setActionPending(action, isPending) {
        actionInFlight = isPending;
        startButton.disabled = isPending;
        stopButton.disabled = isPending;

        if (isPending) {
            setActionFeedback(action === 'start' ? 'Starting...' : 'Stopping...', 'is-pending');
        }
    }

    function applyStatus(data) {
        var running = Boolean(data && data.running);
        var nextNodeSummary = data && data.node_summary ? data.node_summary : (running ? 'Live cluster response' : 'Waiting for service start');
        var nextNodeOutput = data && typeof data.nodes === 'string' ? data.nodes : 'Unable to load node data.';

        statusBadge.classList.toggle('is-running', running);
        statusBadge.classList.toggle('is-stopped', !running);
        statusText.textContent = running ? 'Running' : 'Stopped';
        statusCopy.innerHTML = '<strong>Current state:</strong> <span>' +
            (running ? 'The k3s server process is active.' : 'The k3s server process is not running.') +
            '</span>';
        updateActionButtons(running);
        if (nodeSummary.textContent !== nextNodeSummary) {
            nodeSummary.textContent = nextNodeSummary;
        }
        if (nodeOutput.textContent !== nextNodeOutput) {
            nodeOutput.textContent = nextNodeOutput;
        }
        updateLastChecked(data && data.checked_at ? data.checked_at : null);
    }

    function applyFailure() {
        statusBadge.classList.remove('is-running');
        statusBadge.classList.add('is-stopped');
        statusText.textContent = 'Unavailable';
        statusCopy.innerHTML = '<strong>Current state:</strong> <span>Unable to reach the status endpoint. The last successful node output remains below.</span>';
        lastChecked.textContent = 'Update failed';
    }

    function runAction(action) {
        if (actionInFlight) {
            return;
        }

        setActionPending(action, true);

        fetch(actionUrl, {
            method: 'POST',
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
            },
            body: 'ajax=1&action=' + encodeURIComponent(action),
            cache: 'no-store'
        })
            .then(function (response) {
                if (!response.ok) {
                    throw new Error('HTTP ' + response.status);
                }
                return response.json();
            })
            .then(function (data) {
                if (!data || !data.success) {
                    throw new Error(data && data.message ? data.message : 'Action failed');
                }

                setActionFeedback(
                    action === 'start'
                        ? 'Start command completed. Waiting for status poll...'
                        : 'Stop command completed. Waiting for status poll...',
                    'is-success'
                );
                fetchStatus();
            })
            .catch(function (error) {
                setActionFeedback(error && error.message ? error.message : 'Unable to run action.', 'is-error');
            })
            .then(function () {
                setActionPending(action, false);
            })
        ;
    }

    function fetchStatus() {
        if (requestInFlight) {
            return;
        }

        requestInFlight = true;
        setUpdating(true);

        fetch(statusUrl, {
            method: 'GET',
            headers: {
                'Accept': 'application/json'
            },
            cache: 'no-store'
        })
            .then(function (response) {
                if (!response.ok) {
                    throw new Error('HTTP ' + response.status);
                }
                return response.json();
            })
            .then(function (data) {
                applyStatus(data);
            })
            .catch(function () {
                applyFailure();
            })
            .then(function () {
                requestInFlight = false;
                setUpdating(false);
            })
        ;
    }

    fetchStatus();
    setInterval(fetchStatus, pollIntervalMs);

    startButton.addEventListener('click', function () {
        runAction('start');
    });

    stopButton.addEventListener('click', function () {
        runAction('stop');
    });
})();
</script>

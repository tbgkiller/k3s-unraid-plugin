<?php
// Disable caching
header("Cache-Control: no-cache, no-store, must-revalidate");
header("Pragma: no-cache");
header("Expires: 0");

$plugin_dir = "/boot/config/plugins/k3s-plugin";
$pid_file = "/boot/config/plugins/k3s-plugin/state/k3s.pid";

// Check if running
$is_running = false;
if (file_exists($pid_file)) {
    $pid = trim(file_get_contents($pid_file));
    if ($pid && file_exists("/proc/{$pid}")) {
        $is_running = true;
    }
}
?>

<h2>k3s Status</h2>
<p><strong>Status:</strong> <?= $is_running ? '<span style="color:green">● Running</span>' : '<span style="color:red">● Stopped</span>' ?></p>

<h3>Manual Commands</h3>
<p>Use SSH to control k3s:</p>
<pre style="background:#f4f4f4; color:#000; padding:10px;">
Start:  bash <?= $plugin_dir ?>/start.sh
Stop:   bash <?= $plugin_dir ?>/stop.sh
Status: k3s kubectl get nodes
</pre>

<?php if ($is_running): ?>
<h3>Current Nodes</h3>
<pre style="background:#f4f4f4; color:#000; padding:10px;">
<?= htmlspecialchars(shell_exec("/usr/local/bin/k3s kubectl get nodes 2>&1")) ?>
</pre>
<?php endif; ?>

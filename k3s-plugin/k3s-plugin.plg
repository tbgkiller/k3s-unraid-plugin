<?xml version="1.0"?>
<PLUGIN
  name="k3s-plugin"
  author="Dustin (TBG_Killer)"
  version="2026.03.24"
  pluginURL="https://raw.githubusercontent.com/tbgkiller/k3s-unraid-plugin/main/k3s-plugin/k3s-plugin.plg"
  support="https://forums.unraid.net/"
  min="6.12.0">
  
  <CHANGES>
###2026.03.24
- Initial release
- Installs k3s v1.35.2+k3s1
- Lifecycle scripts for install, start, stop, and uninstall
  </CHANGES>

  <FILE Name="/boot/config/plugins/k3s-plugin/install.sh">
<URL>https://raw.githubusercontent.com/tbgkiller/k3s-unraid-plugin/main/k3s-plugin/install.sh</URL>
  </FILE>
  <FILE Name="/boot/config/plugins/k3s-plugin/start.sh">
<URL>https://raw.githubusercontent.com/tbgkiller/k3s-unraid-plugin/main/k3s-plugin/start.sh</URL>
  </FILE>
  <FILE Name="/boot/config/plugins/k3s-plugin/stop.sh">
<URL>https://raw.githubusercontent.com/tbgkiller/k3s-unraid-plugin/main/k3s-plugin/stop.sh</URL>
  </FILE>
  <FILE Name="/boot/config/plugins/k3s-plugin/uninstall.sh">
<URL>https://raw.githubusercontent.com/tbgkiller/k3s-unraid-plugin/main/k3s-plugin/uninstall.sh</URL>
  </FILE>
  <FILE Name="/usr/local/emhttp/plugins/k3s-plugin/README.md">
<URL>https://raw.githubusercontent.com/tbgkiller/k3s-unraid-plugin/main/k3s-plugin/plugin-info.md</URL>
  </FILE>

  <FILE Run="/bin/bash" Name="/boot/config/plugins/k3s-plugin/install.sh">
<INLINE>
# Already downloaded, just execute
/boot/config/plugins/k3s-plugin/install.sh
</INLINE>
  </FILE>
</PLUGIN>
